<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hazeydata.tpcr-crowd-report</string>
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/theme-park-crowd-report/.venv/bin/python</string>
        <string>__HOME__/theme-park-crowd-report/tpcr-discord-bot/daily_report.py</string>
        <string>--wait-for-pipeline</string>
        <string>90</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__HOME__/theme-park-crowd-report/tpcr-discord-bot</string>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>__HOME__/hazeydata/pipeline/logs/tpcr-crowd-report.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/hazeydata/pipeline/logs/tpcr-crowd-report.err.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
        <key>TPCR_DATA_ROOT</key>
        <string>__HOME__/hazeydata/pipeline</string>
    </dict>
</dict>
</plist>
