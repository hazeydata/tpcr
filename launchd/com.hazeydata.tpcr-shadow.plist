<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hazeydata.tpcr-shadow</string>
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/theme-park-crowd-report/.venv/bin/python</string>
        <string>__HOME__/theme-park-crowd-report/scripts/shadow_job.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__HOME__/theme-park-crowd-report</string>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>20</integer>
    </dict>
    <key>RunAtLoad</key>
    <false/>
    <key>Nice</key>
    <integer>10</integer>
    <key>LowPriorityIO</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__HOME__/hazeydata/pipeline/competition/logs/tpcr-shadow.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/hazeydata/pipeline/competition/logs/tpcr-shadow.err.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
        <key>TPCR_PIPELINE_BASE</key>
        <string>__HOME__/hazeydata/pipeline</string>
        <key>TPCR_DIR</key>
        <string>__HOME__/theme-park-crowd-report</string>
    </dict>
</dict>
</plist>
